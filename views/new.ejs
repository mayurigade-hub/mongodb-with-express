<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Start new chat</title>
</head>
<body>
    <h3>Start new chat</h3>
    <form>
        <input type="text" name="from" placeholder="Who are you?">
        <br/> <br/>
        <input type="text" name="to" placeholder="add receiver">
        <br/><br/>
        <textarea name="msg" placeholder="Type your message here..."></textarea>
        <br/><br/>
        <button type="submit">Send</button>
    </form>
</body>
</html>